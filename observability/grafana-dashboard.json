{
  "title": "Dispatch — standalone observability",
  "uid": "dispatch-standalone",
  "description": "Optional dashboard for Dispatch's opt-in /api/metrics exposition (#1255). Non-Courier: every panel renders from Dispatch's own cache signals, and a fully idle Dispatch shows zeros, not gaps. See docs/observability-packaging.md.",
  "tags": [
    "dispatch"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
