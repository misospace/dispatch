generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Repository {
  id        String   @id @default(cuid())
  name      String
  owner     String
  fullName  String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    Issue[]
}

model Issue {
  id            String     @id @default(cuid())
  number        Int
  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  title         String
  body          String?
  state         String
  url           String
  labels        String[]
  assignees     String[]
  commentsCount Int        @default(0)
  createdAt     DateTime
  updatedAt     DateTime
  closedAt      DateTime?
  lastSyncedAt  DateTime   @default(now())
  currentLane   String?    @default("normal")
  agentRuns     AgentRun[]
  auditLogs     AuditLog[]
  laneHistory   IssueLane[]

  @@unique([repositoryId, number])
  @@index([state])
  @@index([labels])
}

model AgentRun {
  id               String    @id @default(cuid())
  agentName        String
  runType          String
  status           String
  startedAt        DateTime
  finishedAt       DateTime?
  summary          String?
  errorMessage     String?
  notes            String?   @db.Text
  touchedIssueUrls String[]
  createdAt        DateTime  @default(now())
  issueId          String?
  issue            Issue?    @relation(fields: [issueId], references: [id])
}

model AuditLog {
  id           String   @id @default(cuid())
  actor        String
  action       String
  repoFullName String
  issueNumber  Int?
  issueId      String?
  issue        Issue?   @relation(fields: [issueId], references: [id])
  beforeLabels String[]
  afterLabels  String[]
  success      Boolean
  errorMessage String?
  notes        String? @db.Text
  createdAt    DateTime @default(now())

  @@index([repoFullName])
  @@index([issueId])
  @@index([createdAt])
}

model IssueLane {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  lane       String
  confidence String
  reason     String?  @db.Text
  model      String?
  judgedAt   DateTime @default(now())

  @@index([issueId])
  @@index([lane])
}

model AutomationRepo {
  id              String   @id @default(cuid())
  fullName        String   @unique
  name            String
  owner           String
  defaultBranch   String   @default("main")
  latestCommitSha String?
  openPRCount     Int      @default(0)
  lastSyncedAt    DateTime @default(now())
  syncError       String?
  source          String   @default("env")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workflows        GithubWorkflow[]
  releases         GithubRelease[]
  packages         GithubPackage[]
  automationEvents AutomationEvent[]
  syncRuns         AutomationSyncRun[]
  pullRequests     GithubPullRequest[]
  commits          GithubCommit[]

  @@index([owner])
}

model GithubWorkflow {
  id         String         @id @default(cuid())
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  workflowId BigInt         @unique
  name       String
  path       String
  state      String
  createdAt  DateTime
  updatedAt  DateTime
  lastRunAt  DateTime?

  runs GithubWorkflowRun[]

  @@index([repoId])
  @@index([state])
}

model GithubWorkflowRun {
  id           String         @id @default(cuid())
  workflowId   String
  workflow     GithubWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runId        BigInt         @unique
  name         String
  status       String
  conclusion   String?
  branch       String
  headSha      String
  actor        String
  runStartedAt DateTime
  updatedAt    DateTime
  durationSecs Int?

  jobs           GithubWorkflowJob[]
  pullRequestUrl String?

  @@index([workflowId])
  @@index([status])
  @@index([branch])
  @@index([runStartedAt])
}

model GithubWorkflowJob {
  id          String            @id @default(cuid())
  runId       String
  run         GithubWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  jobId       BigInt
  name        String
  status      String
  conclusion  String?
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([runId, jobId])
  @@index([runId])
}

model GithubRelease {
  id           String         @id @default(cuid())
  repoId       String
  repo         AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  releaseId    BigInt
  tagName      String
  name         String?
  draft        Boolean
  prerelease   Boolean
  targetCommit String?
  url          String
  publishedAt  DateTime
  createdAt    DateTime       @default(now())

  @@unique([repoId, releaseId])
  @@index([repoId])
  @@index([publishedAt])
}

model GithubPackage {
  id          String         @id @default(cuid())
  repoId      String
  repo        AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  packageType String
  name        String
  visibility  String
  url         String
  latestTag   String?
  updatedAt   DateTime

  @@unique([repoId, name])
  @@index([repoId])
}

model GithubPullRequest {
  id         String         @id @default(cuid())
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  number     Int
  url        String         @unique
  title      String
  state      String
  author     String
  branch     String
  baseBranch String
  createdAt  DateTime
  updatedAt  DateTime
  mergedAt   DateTime?
  isDraft    Boolean

  @@unique([repoId, number])
  @@index([repoId])
  @@index([state])
}

model GithubCommit {
  id         String         @id @default(cuid())
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  sha        String         @unique
  message    String
  author     String
  authorDate DateTime
  url        String

  @@index([repoId])
  @@index([authorDate])
}

model AutomationEvent {
  id          String         @id @default(cuid())
  repoId      String
  repo        AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  description String?
  actor       String?
  url         String?
  sha         String?
  branch      String?
  status      String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([repoId])
  @@index([eventType])
  @@index([createdAt])
}

model AutomationSyncRun {
  id               String         @id @default(cuid())
  repoId           String
  repo             AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  status           String
  reposFetched     Int            @default(0)
  workflowsFetched Int            @default(0)
  runsFetched      Int            @default(0)
  errorMessage     String?
  notes            String? @db.Text
  startedAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([repoId])
  @@index([startedAt])
}
