generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Repository {
  id        String   @id @default(cuid())
  name      String
  owner     String
  fullName  String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    Issue[]
}

model Issue {
  id                    String                @id @default(cuid())
  number                Int
  repositoryId          String
  repository            Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  title                 String
  body                  String?
  state                 String
  url                   String
  labels                String[]
  assignees             String[]
  commentsCount         Int                   @default(0)
  createdAt             DateTime
  updatedAt             DateTime
  closedAt              DateTime?
  lastSyncedAt          DateTime              @default(now())
  currentLane           String?
  agentRuns             AgentRun[]
  auditLogs             AuditLog[]
  laneHistory           IssueLane[]
  agentWork             AgentWork[]
  leases                Lease[]
  mutationGuard         IssueMutationGuard?
  groomingRuns          GroomingRun[]
  groomingApplications  GroomingApplication[]
  groomingChildClaims   GroomingChildClaim[]
  groomerPendingReplies GroomerPendingReply[]
  lifecycleEvents       IssueLifecycleEvent[]
  handoffSettlements    IssueHandoffSettlement[]

  // Escalated lane outcome tracking
  decomposed     Boolean   @default(false)
  decomposedAt   DateTime?
  decomposedBy   String?   @db.Text
  decomposedNote String?   @db.Text
  followUpUrls   String[]  @default([])

  // Native GitHub blocked_by dependencies (#1086): canonical `owner/repo#N`
  // keys for issues that natively block this one. Ingested by sync; merged
  // with body-parsed deps by the queue gate and board annotation.
  nativeBlockedBy String[] @default([])

  // Backlog grooming state
  groomedAt          DateTime?
  groomedBy          String?   @db.Text
  groomingSummary    String?   @db.Text
  notReadyReason     String?   @db.Text
  blockedReason      String?   @db.Text
  needsInfoReason    String?   @db.Text
  nextGroomingAction String?   @db.Text

  // Grooming freshness (#1064): the evidence identity the latest applied
  // grooming result was validated against, and whether it has gone stale.
  // groomedIssueFingerprint NULL means freshness is unknown (never groomed
  // since freshness was introduced, or the baseline could not be recorded).
  groomedRunId              String?
  groomedHeadSha            String?
  groomedDefaultBranch      String?
  groomedIssueFingerprint   String?
  groomedCommentCount       Int?
  groomedEvidenceDigest     String?
  groomedEvidenceCapturedAt DateTime?
  groomedEvidenceScope      String?
  groomedEvidencePaths      String[]  @default([])
  groomedSearchCodeQueries  String[]  @default([])
  groomedDependencyKeys     String[]  @default([])
  groomedOpenBlockerKeys    String[]  @default([])
  groomedRelatedWork        Json?
  groomingVerifiedSha       String?
  groomingStaleAt           DateTime?
  groomingStaleReasons      String[]  @default([])
  groomingStaleDetail       String?   @db.Text
  // Backoff after a groom that could not read GitHub state (#1063): the
  // selector skips the issue until then, so an unreadable issue cannot
  // monopolize the groomer. Targeted runs ignore it.
  groomingRetryAfter        DateTime?

  // Explicit operator admission override (#1065). The override writes the
  // freshness baseline above with groomedRunId = admissionOverrideId, so it
  // goes stale under the same checks as a grooming result; it is current only
  // while groomedRunId still equals admissionOverrideId.
  admissionOverrideId      String?
  admissionOverrideBy      String?
  admissionOverrideAt      DateTime?
  admissionOverrideReason  String?   @db.Text
  admissionOverrideHeadSha String?

  // Linked PR health (persisted by reconcile, refreshable on demand)
  linkedPrNumber          Int?
  linkedPrUrl             String?
  linkedPrNeedsFollowup   Boolean   @default(false)
  linkedPrFollowupReasons String[]  @default([])
  linkedPrReviewDecision  String?
  linkedPrMergeState      String?
  linkedPrHealthCheckedAt DateTime?

  @@unique([repositoryId, number])
  @@index([currentLane])
  @@index([currentLane, state])
  @@index([state])
  @@index([labels])
  @@index([linkedPrNeedsFollowup])
  @@index([groomingStaleAt])
  @@index([groomingRetryAfter])
}

model IssueMutationGuard {
  issueId    String   @id
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  operation  String
  ownerToken String   @unique
  agentName  String?
  claimToken String?
  executing  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([agentName, claimToken])
}

enum PrFixLane {
  NORMAL
  ESCALATED
  NEEDS_HUMAN
}

enum PrFixStatus {
  QUEUED
  FIXED
  BLOCKED
  PARKED
  STALE
  IGNORED
  WAITING_EXTERNAL
}

enum PrFixType {
  MERGE_CONFLICT
  CI_FAILURE
  REVIEW_FEEDBACK
  OTHER
}

model PrFixQueueItem {
  id                       String          @id @default(cuid())
  repo                     String
  pr                       Int
  issue                    Int?
  branch                   String?
  lane                     PrFixLane       @default(NORMAL)
  type                     PrFixType       @default(OTHER)
  reason                   String          @db.Text
  feedback                 String[]        @default([])
  evidenceKeys             String[]        @default([])
  status                   PrFixStatus     @default(QUEUED)
  // Structured outcome classification (#1218): why the item is in its current
  // non-active terminal-ish state. Only meaningful for BLOCKED (human_decision)
  // and PARKED (no_progress | infra_failure | security_failure).
  outcome                  String?
  // Human-decision payload for a BLOCKED item (#1218): the question, options,
  // and evidence an operator needs to make the call. Null for non-human states.
  decisionDetail           Json?
  // Dispatch-owned work generation (#1044): 1 on creation, bumped when a
  // non-QUEUED item becomes dispatchable again as a fresh attempt. Workers
  // consume (id, generation) as an opaque work identity via next-task.
  generation               Int             @default(1)
  queuedAt                 DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  url                      String?
  title                    String?
  headSha                  String?
  // Immutable head baseline for the current attempt/generation (#1074),
  // captured when the attempt becomes dispatchable. The FIXED guard compares
  // the PR head against this baseline, not the mutable enqueue-time headSha.
  attemptHeadSha           String?
  // Dispatchable fix attempts since creation or the last operator requeue
  // (#1103): 1 on creation, +1 per fresh attempt. PR_FIX_MAX_ATTEMPTS bounds
  // this, not evidence keys — one review can carry many comment keys.
  fixAttempts              Int             @default(1)
  // Last next-task hand-out of this item (#1119): the generation handed to
  // the worker (NULL = never dispatched in its current life) and the
  // wall-clock of that hand-out.
  dispatchedGeneration     Int?
  dispatchedAt             DateTime?
  // #1256: authoritative per-hand-out receipts. One entry per live hand-out
  // issued by next-task, format "<token>@<agentName>@<generation>" (token is
  // an opaque random value containing no "@"; the agent name may contain "@",
  // so the token boundary is the FIRST "@" and the generation the LAST).
  // Settlement of a capacity-exhausted report requires the reporting agent to
  // present the exact token it was issued, and the write releases only that
  // agent's receipt — other agents' live hand-outs and acknowledgements at
  // the same generation survive. Invariant: an entry exists exactly while the
  // matching `agentHandouts` entry exists (issuance pushes both atomically;
  // every clear site clears both), so a hand-out that was released, reclaimed,
  // or superseded by a generation bump can never be settled with its old
  // token, and each new hand-out rotates in a fresh token.
  handoutReceipts          String[]        @default([])
  // New (previously-unrecorded) evidence arrived AFTER the current generation
  // was handed out (#1119): the in-flight worker cannot see it, so settlement
  // must reopen a fresh attempt instead of absorbing it. Records the evidence
  // keys that arrived after the hand-out, each encoded as
  // `<evidenceKey>@<head>` where <head> is the enqueue's observed headSha
  // (trimmed) or the literal "unknown" when none was recorded. Empty list =
  // nothing to act on; cleared on every fresh attempt and settlement.
  postDispatchEvidenceKeys String[]        @default([])
  // Agents this item was already handed to, per generation (#1133): each
  // entry is `<agentName>@<generation>`. next-task skips an item for an
  // agent that already received its CURRENT generation — a polling worker
  // drops the re-hand (it already has a run for that work identity), so
  // re-handing it only starves the lane behind it. Another agent still gets
  // the item, and the same agent gets it again when a fresh attempt bumps
  // the generation; entries for older generations are inert, and every
  // fresh attempt clears the list.
  agentHandouts            String[]        @default([])
  // Acknowledged hand-outs, per generation (#1211): each entry is
  // `<agentName>@<generation>`, written when a worker durably materialized the
  // attempt (e.g. created the executor run that owns the work). next-task
  // stamps a hand-out and records the agent in `agentHandouts`, but a worker
  // that dies before durably creating its run leaves no trace — no ack, no
  // re-offer — and the item is stranded. The reclaimer refuses to reclaim a
  // generation any agent acknowledged; entries for older generations are inert
  // and every fresh attempt clears the list.
  handoutAcks              String[]        @default([])
  // Bounded automatic reclamations of stale unacknowledged hand-outs (#1211):
  // counts how many times the reclaimer has reopened this item because a
  // stamped hand-out was never acknowledged. Past PR_FIX_MAX_RECLAIMS the item
  // parks as PARKED in the NORMAL lane with outcome=`no_progress` (#1218) —
  // bounded no-progress exhaustion, never a human decision, so the
  // `needs-human` label is never applied. Release requires an explicit
  // operator requeue or a maintainer mark to QUEUED.
  handoutReclaims          Int             @default(0)
  // Cooldown deadline for external dependency waits; due items are reissued lazily.
  retryAt                  DateTime?
  // Durable evidence ledger position counter (#1249): every recorded ledger
  // transition assigns the next sequence from this column (atomic increment on
  // the same pinned write that records it). Monotonic for the item's life;
  // never reset by fresh attempts — the ledger is per-item, not per-attempt.
  evidenceSequence         Int             @default(0)
  // Evidence-snapshot boundary of the CURRENT hand-out (#1249): the ledger
  // sequence at dispatch — the durable record of what the worker was actually
  // given. A transition recorded AFTER it was not in the issued snapshot and
  // can be fresh; at-or-before it was. Cleared on every fresh attempt
  // (freshAttemptGeneration) alongside postDispatchEvidenceKeys; NULL = never
  // dispatched in the current life, so the durable ledger cannot decide
  // freshness and callers use the bounded cache fast path.
  attemptEvidenceWatermark Int?
  // Structured external-wait contract (#1250): bounded { kind, ref, evidence,
  // trigger } validated at every WAITING_EXTERNAL writer. Null on a
  // WAITING_EXTERNAL row means a legacy free-text wait (pre-#1250) — surfaced
  // for operator action, never auto-downgraded.
  externalWait             Json?
  // #1253 stale-disposition flag: set when fresh actionable evidence arrived
  // while the item sat in a disposition evidence must not override
  // (BLOCKED human decision, cap-exhausted or fail-closed PARKED). Operator-
  // visible via queue listings and blocked-context surfacing; cleared on the
  // next reactivation or operator requeue. Never reopens anything by itself.
  staleDisposition         Boolean         @default(false)
  // Audit stamp of the CURRENT disposition (#1253): when it was recorded and
  // the evidence key that caused it. Audit only — never a freshness
  // predicate; the durable ledger + watermark decide freshness (#1249).
  disposedAt               DateTime?
  disposedEvidence         String?
  // Cooldown timestamp for evidence-driven reactivation of operational holds
  // (#1253): set on every reactivation. Paces PARKED/no_progress reopen so
  // reconciliation cannot loop; budget and attempt caps still bound the cycle.
  recoveryAppliedAt        DateTime?
  // Fair-eligibility stamp for the bounded external-wait trigger
  // reconciliation pass (#1253): the last time the pass CONSIDERED this row
  // (reached it during a scan, whether or not it was evaluable). The scan
  // orders least-recently-considered first with an explicit
  // `nulls: "first"`, so an earlier unsatisfied, invalid, or non-live row
  // cannot starve a later wait out of discovery. Audit only — never a
  // freshness or satisfaction predicate; NULL = never considered.
  triggerEvaluatedAt       DateTime?
  author                   String?
  history                  PrFixHistory[]
  evidence                 PrFixEvidence[]

  @@unique([repo, pr])
  @@index([status])
  @@index([lane])
  @@index([status, lane])
  @@index([type])
  @@index([status, type])
  // Fair-eligibility read of the external-wait trigger pass (#1253): NULLS
  // FIRST is part of the index key order because it is part of the ORDER BY;
  // the trailing `id` matches the deterministic tiebreak.
  @@index([status, triggerEvaluatedAt(sort: Asc, nulls: First), id])
  // #1183: the attempt-chain read fetches the queue items for one work
  // item's exact (repo, issue) coordinates.
  @@index([repo, issue])
}

model PrFixHistory {
  id          String         @id @default(cuid())
  itemId      String
  item        PrFixQueueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  at          DateTime       @default(now())
  action      String
  status      String?
  lane        String?
  reason      String?        @db.Text
  note        String?        @db.Text
  evidenceKey String?
  outcome     String?

  @@index([itemId])
  @@index([at])
}

// Durable per-item evidence ledger (#1249): one row per (item, identity)
// holding the CURRENT forge-authoritative version of that identity, the
// per-item transition sequence at which the current version was first
// recorded, and the bounded content signature. Re-recording an already-stored
// (identity, version) never creates a transition and never restamps anything,
// so replayed webhooks and periodic re-reads are inert against the ledger.
// The condition kinds (merge_state / merge_conflict) carry one stable identity
// per PR, making this row the durable per-condition baseline that survives
// bounded-cache eviction and unrelated dispositions. Rows are never pruned on
// a live item; terminal items may be pruned by follow-up cleanup.
model PrFixEvidence {
  id               String         @id @default(cuid())
  itemId           String
  item             PrFixQueueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // Forge-authoritative identity (review:<repo>#<pr>:<id>, ..., or the stable
  // condition identity merge_state:<repo>#<pr> / merge_conflict:<repo>#<pr>).
  identity         String
  kind             String
  version          String
  contentSignature String?
  // Forge-side event timestamp (review submitted_at, comment updated_at,
  // check completed_at). AUDIT ONLY — never a freshness predicate: late
  // discovery stays fresh and replays stay inert via transition position.
  observedAt       DateTime?
  headSha          String?
  source           String?
  // Whether the CURRENT version is actionable by kind
  // (`isActionableEvidenceVersion`). Settlement's durable post-dispatch set
  // only counts actionable rows; cleared/dismissed/resolved versions stay
  // recorded for audit without forcing a reopen.
  actionable       Boolean        @default(true)
  // Per-item monotonic transition position assigned from
  // PrFixQueueItem.evidenceSequence when the CURRENT version was recorded.
  sequence         Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([itemId, identity])
  @@index([itemId, sequence])
  @@index([itemId, contentSignature])
}

model AgentRun {
  id               String    @id @default(cuid())
  agentName        String
  runType          String
  status           String
  startedAt        DateTime
  finishedAt       DateTime?
  summary          String?
  errorMessage     String?
  notes            String?   @db.Text
  // URL-only: entries must be real http(s) issue/PR URLs (e.g.
  // https://github.com/owner/repo/issues/N). Enforced at the API write
  // boundaries (POST /api/agent-runs, heartbeat route); sync runs store [].
  //
  // There is no DB-level CHECK constraint — only API validation guards writes,
  // so any historical rows containing "repo:owner/name" placeholders written
  // before validation was added remain valid in the column until pruned by
  // a follow-up cleanup. Renderers that treat non-https entries as broken
  // links should be aware of this when deciding how to handle them.
  touchedIssueUrls String[]
  // #1183: optional worker-supplied execution metadata (worker product,
  // model, effective reasoning effort, runtime/config revision, experiment/
  // cohort label). Bounded and validated at the API write boundaries (the
  // tasks/report route, via src/lib/execution-metadata.ts): recognized keys
  // only, trimmed printable-ASCII strings of at most 128 characters on a
  // single line. This is STRUCTURAL validation only, not a content filter —
  // a credential short enough to fit the shape would pass; workers must not
  // send secrets and Dispatch does not scan content. The shape keeps
  // multiline prompts and stack traces out and bounds size. Values are
  // preserved (trimmed), never inferred; absent stays null.
  executionMetadata Json?
  createdAt        DateTime  @default(now())
  issueId          String?
  issue            Issue?    @relation(fields: [issueId], references: [id])

  // Escalated lane outcome tracking
  outcome       EscalatedOutcome?
  groomingRuns  GroomingRun[]
  reportDedupes AgentReportDedupe[]

  @@index([agentName])
  @@index([runType])
  @@index([status])
  @@index([createdAt])
  // #1183: the attempt-chain read resolves an issue's run evidence by issueId.
  @@index([issueId])
}

enum EscalatedOutcome {
  PR_OPENED
  PR_UPDATED
  FOLLOW_UP_CREATED
  DESIGN_COMMENT_POSTED
  DECOMPOSED_SKIPPED
  STUCK
}

// Durable idempotency claims for tasks/report (#1044): a worker that crashes
// between Dispatch committing a report and recording the result locally will
// retry the same report. The (agentName, idempotencyKey) unique constraint
// makes the claim atomic against concurrent duplicates; payloadHash rejects
// key reuse with a different report (409); agentRunId and prFixResolution
// replay the original logical result to retries without re-running side
// effects. The key is opaque worker-chosen state — no producer-specific
// semantics.
model AgentReportDedupe {
  id              String    @id @default(cuid())
  agentName       String
  idempotencyKey  String
  payloadHash     String
  agentRunId      String?
  agentRun        AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  prFixResolution Json?
  // #1143: the `already_done` close resolution (action/reasons/head SHA/evidence
  // digest), persisted so an idempotent retry replays the close outcome instead
  // of re-running the GitHub close.
  closeResolution Json?
  createdAt       DateTime  @default(now())

  @@unique([agentName, idempotencyKey])
  @@index([agentName])
}

// ---------------------------------------------------------------------------
// IssueLifecycleEvent — the durable, worker-neutral event stream for a work
// item's lifecycle (#1202). IssueLane already records lane history; this
// records claim / release / status / completion history so a later
// claim-to-merge read never has to infer a first claim from issue creation or
// overwrite an earlier attempt.
//
// Every row belongs to the Issue it describes (there is no Courier-specific
// table or side channel), and every writer — API route, hosted groomer,
// reconciler, sync, webhook, worker report — goes through
// src/lib/issue-lifecycle.ts, so the taxonomy and the idempotency rules live in
// one place.
//
// `occurredAt` is when the transition happened; `observedAt` is when Dispatch
// saw it. A late or out-of-order observation keeps its real occurredAt and is
// never backdated into observedAt, and events are never replayed back onto
// Issue state, so the present status can only be changed by the writer that
// owns it. `dedupeKey` carries a source-provided identity (a GitHub delivery
// id, a merged-PR identity, a sync's issue-updated_at) so redelivery upserts
// instead of duplicating; Dispatch-authored writes leave it NULL and rely on
// the no-op-transition guard instead.
//
// See docs/issue-lifecycle-events.md for the taxonomy and migration notes.
// ---------------------------------------------------------------------------

model IssueLifecycleEvent {
  id            String   @id @default(cuid())
  issueId       String
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  repoFullName  String
  issueNumber   Int
  // Taxonomy: claim | claim_released | attempt_failed | status_changed |
  // completed | issue_closed | issue_reopened | pr_merged.
  kind          String
  // The writer that produced this event (see LIFECYCLE_SOURCES).
  source        String
  // The identity responsible: an agent name, an operator actor, or the
  // automation's own name.
  actor         String
  agentName     String?
  fromStatus    String?
  toStatus      String?
  // Identity of the event in its source system, when the source has one
  // (GitHub delivery id, PR number + merged_at, webhook action). NULL for
  // writes Dispatch authors itself.
  sourceEventId String?
  // Idempotency identity for externally observed events; unique, so a
  // redelivered webhook or a repeated sync upserts instead of duplicating.
  // NULL means "no source identity" — those writes are guarded by the
  // transition check instead.
  dedupeKey     String?  @unique
  occurredAt    DateTime
  observedAt    DateTime @default(now())
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([issueId, occurredAt])
  @@index([issueId, kind])
  @@index([issueId, kind, occurredAt])
  @@index([repoFullName, issueNumber])
  @@index([kind])
}

model AuditLog {
  id           String   @id @default(cuid())
  actor        String
  action       String
  repoFullName String
  issueNumber  Int?
  issueId      String?
  issue        Issue?   @relation(fields: [issueId], references: [id])
  beforeLabels String[]
  afterLabels  String[]
  success      Boolean
  errorMessage String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([repoFullName])
  @@index([issueId])
  @@index([createdAt])
}

model IssueLane {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  lane       String
  confidence String
  reason     String?  @db.Text
  model      String?
  judgedAt   DateTime @default(now())

  @@index([issueId])
  @@index([lane])
}

model AutomationRepo {
  id              String   @id @default(cuid())
  fullName        String   @unique
  name            String
  owner           String
  defaultBranch   String   @default("main")
  latestCommitSha String?
  openPRCount     Int      @default(0)
  lastSyncedAt    DateTime @default(now())
  syncError       String?
  source          String   @default("env")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workflows        GithubWorkflow[]
  releases         GithubRelease[]
  packages         GithubPackage[]
  automationEvents AutomationEvent[]
  syncRuns         AutomationSyncRun[]
  pullRequests     GithubPullRequest[]
  commits          GithubCommit[]
  groomingRuns     GroomingRun[]

  @@index([owner])
}

model GithubWorkflow {
  id         String         @id @default(cuid())
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  workflowId BigInt         @unique
  name       String
  path       String
  state      String
  createdAt  DateTime
  updatedAt  DateTime
  lastRunAt  DateTime?

  runs GithubWorkflowRun[]

  @@index([repoId])
  @@index([state])
}

model GithubWorkflowRun {
  id           String         @id @default(cuid())
  workflowId   String
  workflow     GithubWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runId        BigInt         @unique
  name         String
  status       String
  conclusion   String?
  branch       String
  headSha      String
  actor        String
  runStartedAt DateTime
  updatedAt    DateTime
  durationSecs Int?

  jobs           GithubWorkflowJob[]
  pullRequestUrl String?

  @@index([workflowId])
  @@index([status])
  @@index([branch])
  @@index([runStartedAt])
}

model GithubWorkflowJob {
  id          String            @id @default(cuid())
  runId       String
  run         GithubWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  jobId       BigInt
  name        String
  status      String
  conclusion  String?
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([runId, jobId])
  @@index([runId])
}

model GithubRelease {
  id           String         @id @default(cuid())
  repoId       String
  repo         AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  releaseId    BigInt
  tagName      String
  name         String?
  draft        Boolean
  prerelease   Boolean
  targetCommit String?
  url          String
  publishedAt  DateTime
  createdAt    DateTime       @default(now())

  @@unique([repoId, releaseId])
  @@index([repoId])
  @@index([publishedAt])
}

model GithubPackage {
  id          String         @id @default(cuid())
  repoId      String
  repo        AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  packageType String
  name        String
  visibility  String
  url         String
  latestTag   String?
  updatedAt   DateTime

  @@unique([repoId, name])
  @@index([repoId])
}

model GithubPullRequest {
  id         String         @id @default(cuid())
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  number     Int
  url        String         @unique
  title      String
  state      String
  author     String
  branch     String
  baseBranch String
  createdAt  DateTime
  updatedAt  DateTime
  mergedAt   DateTime?
  isDraft    Boolean

  @@unique([repoId, number])
  @@index([repoId])
  @@index([state])
}

model GithubCommit {
  id         String         @id @default(cuid())
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  sha        String         @unique
  message    String
  author     String
  authorDate DateTime
  url        String

  @@index([repoId])
  @@index([authorDate])
}

model AutomationEvent {
  id          String         @id @default(cuid())
  repoId      String
  repo        AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  description String?
  actor       String?
  url         String?
  sha         String?
  branch      String?
  status      String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([repoId])
  @@index([eventType])
  @@index([createdAt])
}

model AutomationSyncRun {
  id               String         @id @default(cuid())
  repoId           String
  repo             AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  status           String
  reposFetched     Int            @default(0)
  workflowsFetched Int            @default(0)
  runsFetched      Int            @default(0)
  errorMessage     String?
  notes            String?        @db.Text
  startedAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([repoId])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// GroomingRun — tracks individual issue grooming executions by the hosted groomer.
// ---------------------------------------------------------------------------

model GroomingRun {
  id         String         @id @default(cuid())
  issueId    String
  issue      Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  agentRunId String?
  agentRun   AgentRun?      @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  repoFullName    String
  issueNumber     Int
  issueUrl        String
  status          String
  dryRun          Boolean
  candidateSource String   @default("selector")
  staleReasons    String[] @default([])
  stage           String   @default("selected")

  model           String?
  provider        String?
  promptVersion   String  @default("hosted-groomer-v1")
  timeoutMs       Int?
  maxContextBytes Int?

  contextSummary   Json?
  contextWarnings  String[] @default([])
  rawOutput        Json?
  validatedOutput  Json?
  validationErrors String[] @default([])

  labelsBefore       String[] @default([])
  labelsAfter        String[] @default([])
  labelsToAdd        String[] @default([])
  labelsToRemove     String[] @default([])
  laneBefore         String?
  laneAfter          String?
  mutationPlan       Json?
  appliedMutations   Json?
  commentBodyPreview String?  @db.Text
  commentUrl         String?

  errorMessage String?   @db.Text
  retryable    Boolean   @default(false)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Apply-time validation and idempotent application (#1063).
  applicationKey       String?
  applyOutcome         String?
  preconditions        Json?
  preconditionFailures String[]              @default([])
  applications         GroomingApplication[]

  @@index([repoFullName])
  @@index([issueId])
  @@index([repoId])
  @@index([agentRunId])
  @@index([applicationKey])
  @@index([status])
  @@index([dryRun])
  @@index([createdAt])
  @@index([issueId, createdAt])
  @@index([repoId, status, createdAt])
  @@index([issueId, status])
}

// One logical application of a grooming plan (#1063), keyed by
// repo + issue + evidence digest + plan version + normalized mutation intent.
// The unique key is the claim: a retried or duplicated run with the same key
// replays the recorded steps instead of repeating GitHub side effects.
model GroomingApplication {
  id             String       @id @default(cuid())
  applicationKey String       @unique
  issueId        String
  issue          Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  groomingRunId  String?
  groomingRun    GroomingRun? @relation(fields: [groomingRunId], references: [id], onDelete: SetNull)
  repoFullName   String
  issueNumber    Int
  status         String
  steps          Json
  attempts       Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([issueId])
  @@index([groomingRunId])
}

/// One row per child brief the hosted groomer intends for a decomposed parent
/// (#1066). The unique childKey (parent issue + normalized child brief) is
/// the claim: creation is idempotent, so a retry after partial failure reuses
/// children whose rows already carry their URLs and creates only the missing
/// ones.
model GroomingChildClaim {
  id             String   @id @default(cuid())
  childKey       String   @unique
  parentIssueId  String
  repoFullName   String
  parentNumber   Int
  title          String   @db.Text
  childNumber    Int?
  childUrl       String?  @db.Text
  /// The application that claimed this child. Same-key attempts are not
  /// expected to run concurrently (the GroomingApplication resume CAS
  /// serializes fresh claims, and the groomer is confined to a single
  /// replica), so a null claim under my key is my own abandoned create.
  /// No FK: the application row may be deleted later.
  applicationKey String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parentIssue Issue @relation(fields: [parentIssueId], references: [id], onDelete: Cascade)

  @@index([parentIssueId])
}

model GroomerPendingReply {
  id             String    @id @default(cuid())
  applicationKey String    @unique
  repoFullName   String
  issueNumber    Int
  issueId        String
  issue          Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  groomingRunId  String?
  commentBody    String    @db.Text
  reason         String
  trustContext   Json
  status         String    @default("pending")
  approvedBy     String?
  approvedAt     DateTime?
  postedUrl      String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([issueId])
  @@index([status])
  @@index([repoFullName, issueNumber])
}

// ---------------------------------------------------------------------------
// Issue sync run tracking (for scheduled sync endpoint)
// ---------------------------------------------------------------------------

model IssueSyncRun {
  id           String    @id @default(cuid())
  status       String
  reposFetched Int       @default(0)
  syncedCount  Int       @default(0)
  errorMessage String?
  notes        String?   @db.Text
  syncType     String    @default("scheduled") // "scheduled" | "manual" | "automation"
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([startedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Sync lock — single-row table to prevent overlapping scheduled sync runs.
// Uses a single row (id = "global") with atomic upsert for lock acquisition.
// ---------------------------------------------------------------------------

model SyncLock {
  id         String   @id
  syncRunId  String?
  acquiredAt DateTime @default(now())

  @@map("sync_lock")
}

// ---------------------------------------------------------------------------
// Agent work lease / checkpoint — tracks active agent work on issues/PRs.
// ---------------------------------------------------------------------------

enum AgentWorkState {
  CLAIMED
  IN_PROGRESS
  BLOCKED
  DONE
  RELEASED
  STALE
}

enum AgentWorkCheckpoint {
  CLAIMED
  REPO_PREPARED
  BRANCH_CREATED
  CHANGES_MADE
  TESTS_RUNNING
  PR_OPENED
  DONE
  BLOCKED
}

model AgentWork {
  id                       String              @id @default(cuid())
  agentName                String
  issueId                  String?
  issue                    Issue?              @relation(fields: [issueId], references: [id])
  runId                    String?
  state                    AgentWorkState      @default(CLAIMED)
  checkpoint               AgentWorkCheckpoint @default(CLAIMED)
  branch                   String?
  prUrl                    String?
  leaseExpiresAt           DateTime?
  lastHeartbeatAt          DateTime            @default(now())
  staleClaimReleasePending Boolean             @default(false)
  summary                  String?             @db.Text
  blockerReason            String?             @db.Text
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  history                  AgentWorkHistory[]

  @@index([agentName])
  @@index([state])
  @@index([issueId])
}

model AgentWorkHistory {
  id            String               @id @default(cuid())
  workId        String
  work          AgentWork            @relation(fields: [workId], references: [id], onDelete: Cascade)
  at            DateTime             @default(now())
  action        String
  state         AgentWorkState?
  checkpoint    AgentWorkCheckpoint?
  summary       String?              @db.Text
  blockerReason String?              @db.Text

  @@index([workId])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Agent work leases — durable checkpointing for resumable agent work.
//
// A Lease represents an agent's active ownership of a specific issue. It is
// created or renewed on claim, checked on active-work queries, and expired
// after a configurable TTL so that stale work can be recovered by other agents.
// ---------------------------------------------------------------------------

model Lease {
  id                     String    @id @default(cuid())
  agentName              String
  issueId                String
  issue                  Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  checkpoint             String // e.g. "issue_claimed", "branch_created", etc.
  branch                 String? // working branch name
  prUrl                  String? // associated PR URL if one exists
  expiredAt              DateTime // absolute expiry; default TTL is set at creation time
  renewedAt              DateTime?
  // #1256: opaque attempt/claim token issued to the worker on claim. It fences
  // a capacity-handoff release to the EXACT claim: renewals keep the token,
  // but a released/expired lease that is re-claimed gets a fresh row and a
  // fresh token, so a stale worker's token can never release a newer claim.
  claimToken             String?   @unique
  // #1251: optional worker ownership capability (docs/ownership-reconciliation.md §6).
  // The durable registration / fenced renewal / terminal disposition reuse this
  // row instead of a parallel lease table. Every column is nullable: a client
  // that never adopts the capability leaves them unset and stays conservatively
  // unverified (never auto-abandoned). Renew/claim mutations serialize against
  // these writes through the per-issue IssueMutationGuard.
  runRef                 String? // worker-supplied durable run reference recorded at registration
  registeredAt           DateTime? // server-observed time a durable owner registered
  registrationOccurredAt DateTime? // worker-reported occurrence time of the registration
  renewCount             Int       @default(0)
  lastRenewalObservedAt  DateTime? // server clock of the last accepted renewal
  lastRenewalOccurredAt  DateTime? // worker-reported occurrence time of the last accepted renewal
  retryAfter             DateTime? // external-wait marker; ownership defers until this time
  waitReason             String?
  disposition            String? // terminal: completed | released | blocked | handed_off
  dispositionNote        String?
  successorRef           String? // successor agent / PR link supplied with the disposition
  dispositionOccurredAt  DateTime?
  dispositionObservedAt  DateTime?
  createdAt              DateTime  @default(now())

  @@unique([agentName, issueId])
  @@index([agentName, expiredAt])
  @@index([expiredAt])
  @@index([issueId])
}

// ---------------------------------------------------------------------------
// Capacity handoffs (#1256) — bounded, capacity-SCOPED cooldowns.
//
// When a worker explicitly recognizes that its execution capacity (an opaque
// provider/model/runner identifier chosen by the worker) cannot run a handed
// attempt, it settles the attempt with a fenced handoff. Dispatch keeps the
// work item itself discoverable to other compatible workers; this table only
// records "capacity C should not be re-handed <this item> until T". Workers
// that declare no capacity conservatively skip cooled items (fail-closed).
// Expired rows are pruned lazily on read; they carry no retry budget.
// ---------------------------------------------------------------------------

model CapacityHandoff {
  id            String   @id @default(cuid())
  capacity      String // opaque worker-declared capacity identifier
  // Which subsystem owns the handed-off work: "issue" (claim/lease release)
  // or "pr_fix" (PR-fix queue attempt).
  kind          String
  repoFullName  String
  issueNumber   Int?
  prNumber      Int?
  // The worker that handed the work off, for audit/history.
  agentName     String
  issueId       String? // issue-form handoffs: the local Issue row
  // The attempt generation the handoff settles (pr_fix rows). The replay
  // check is keyed on it so a fresh attempt is never absorbed by an older
  // generation's cooldown window.
  generation    Int?
  cooldownUntil DateTime // handoff suppresses re-hand to `capacity` before this time
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([capacity, cooldownUntil])
  @@index([kind, repoFullName, issueNumber, cooldownUntil])
  @@index([kind, repoFullName, prNumber, cooldownUntil])
  @@index([cooldownUntil])
}

// ---------------------------------------------------------------------------
// Issue handoff settlements (#1262) — durable idempotent replay records.
//
// A completed issue capacity handoff is recorded here, bound to the exact
// issued claim token and a caller settlement key. When both the HTTP success
// response and the best-effort audit row are lost, a retry with the same key
// and the original claim token replays the recorded success without touching
// any newer claim, label, or human hold. Rows are bounded (settledAt +
// retention) and pruned lazily; they are proof of a past release, never
// dispatch state, and never a substitute for live ownership verification.
// ---------------------------------------------------------------------------

model IssueHandoffSettlement {
  id            String    @id @default(cuid())
  agentName     String
  issueId       String
  issue         Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  // The exact claim incarnation settled. Replay requires token equality; a
  // newer claim's token never matches and is refused, never replayed over.
  claimToken    String
  // Caller-chosen idempotency key for the settlement operation (opaque, at
  // most 200 chars). One settlement per (agent, issue, key); first write wins
  // so a crash-resumed attempt can never rewrite the original proof.
  settlementKey String
  capacity      String
  // Recorded successful release result, replayed verbatim.
  labels        String[]
  status        String?
  statusNote    String?
  cooldownUntil DateTime?
  settledAt     DateTime
  // Bounded retention deadline; expired rows are pruned lazily on lookup and
  // an expired proof is refused, never replayed.
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@unique([agentName, issueId, settlementKey])
  @@index([expiresAt])
}
