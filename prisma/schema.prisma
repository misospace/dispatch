generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Repository {
  id        String   @id @default(cuid())
  name      String
  owner     String
  fullName  String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    Issue[]
}

model Issue {
  id            String     @id @default(cuid())
  number        Int
  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  title         String
  body          String?
  state         String
  url           String
  labels        String[]
  assignees     String[]
  commentsCount Int        @default(0)
  createdAt     DateTime
  updatedAt     DateTime
  closedAt      DateTime?
  lastSyncedAt  DateTime   @default(now())
  currentLane   String?    @default("normal")
  agentRuns     AgentRun[]
  auditLogs     AuditLog[]
  laneHistory   IssueLane[]
  agentWork     AgentWork[]
  leases        Lease[]

  // Escalated lane outcome tracking
  decomposed    Boolean  @default(false)
  decomposedAt  DateTime?
  decomposedBy  String?  @db.Text
  decomposedNote String? @db.Text
  followUpUrls  String[] @default([])

  // Backlog grooming state
  groomedAt        DateTime?
  groomedBy        String?  @db.Text
  groomingSummary  String?  @db.Text
  notReadyReason   String?  @db.Text
  blockedReason    String?  @db.Text
  needsInfoReason  String?  @db.Text
  nextGroomingAction String? @db.Text

  @@unique([repositoryId, number])
  @@index([state])
  @@index([labels])
}

enum PrFixLane {
  NORMAL
  ESCALATED
  NEEDS_HUMAN
}

enum PrFixStatus {
  QUEUED
  FIXED
  BLOCKED
  STALE
  IGNORED
}

model PrFixQueueItem {
  id           String         @id @default(cuid())
  repo         String
  pr           Int
  issue        Int?
  branch       String?
  lane         PrFixLane      @default(NORMAL)
  reason       String         @db.Text
  feedback     String[]       @default([])
  evidenceKeys String[]       @default([])
  status       PrFixStatus    @default(QUEUED)
  queuedAt     DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  url          String?
  title        String?
  headSha      String?
  author       String?
  history      PrFixHistory[]

  @@unique([repo, pr])
  @@index([status])
  @@index([lane])
  @@index([status, lane])
}

model PrFixHistory {
  id          String         @id @default(cuid())
  itemId      String
  item        PrFixQueueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  at          DateTime       @default(now())
  action      String
  status      String?
  reason      String?        @db.Text
  note        String?        @db.Text
  evidenceKey String?

  @@index([itemId])
  @@index([at])
}

model AgentRun {
  id               String    @id @default(cuid())
  agentName        String
  runType          String
  status           String
  startedAt        DateTime
  finishedAt       DateTime?
  summary          String?
  errorMessage     String?
  notes            String?   @db.Text
  touchedIssueUrls String[]
  createdAt        DateTime  @default(now())
  issueId          String?
  issue            Issue?    @relation(fields: [issueId], references: [id])

  // Escalated lane outcome tracking
  outcome          EscalatedOutcome?

  @@index([agentName])
  @@index([runType])
  @@index([status])
  @@index([createdAt])
}

enum EscalatedOutcome {
  PR_OPENED
  PR_UPDATED
  FOLLOW_UP_CREATED
  DESIGN_COMMENT_POSTED
  DECOMPOSED_SKIPPED
  STUCK
}

model AuditLog {
  id           String   @id @default(cuid())
  actor        String
  action       String
  repoFullName String
  issueNumber  Int?
  issueId      String?
  issue        Issue?   @relation(fields: [issueId], references: [id])
  beforeLabels String[]
  afterLabels  String[]
  success      Boolean
  errorMessage String?
  notes        String? @db.Text
  createdAt    DateTime @default(now())

  @@index([repoFullName])
  @@index([issueId])
  @@index([createdAt])
}

model IssueLane {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  lane       String
  confidence String
  reason     String?  @db.Text
  model      String?
  judgedAt   DateTime @default(now())

  @@index([issueId])
  @@index([lane])
}

model AutomationRepo {
  id              String   @id @default(cuid())
  fullName        String   @unique
  name            String
  owner           String
  defaultBranch   String   @default("main")
  latestCommitSha String?
  openPRCount     Int      @default(0)
  lastSyncedAt    DateTime @default(now())
  syncError       String?
  source          String   @default("env")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workflows        GithubWorkflow[]
  releases         GithubRelease[]
  packages         GithubPackage[]
  automationEvents AutomationEvent[]
  syncRuns         AutomationSyncRun[]
  pullRequests     GithubPullRequest[]
  commits          GithubCommit[]

  @@index([owner])
}

model GithubWorkflow {
  id         String         @id @default(cuid())
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  workflowId BigInt         @unique
  name       String
  path       String
  state      String
  createdAt  DateTime
  updatedAt  DateTime
  lastRunAt  DateTime?

  runs GithubWorkflowRun[]

  @@index([repoId])
  @@index([state])
}

model GithubWorkflowRun {
  id           String         @id @default(cuid())
  workflowId   String
  workflow     GithubWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runId        BigInt         @unique
  name         String
  status       String
  conclusion   String?
  branch       String
  headSha      String
  actor        String
  runStartedAt DateTime
  updatedAt    DateTime
  durationSecs Int?

  jobs           GithubWorkflowJob[]
  pullRequestUrl String?

  @@index([workflowId])
  @@index([status])
  @@index([branch])
  @@index([runStartedAt])
}

model GithubWorkflowJob {
  id          String            @id @default(cuid())
  runId       String
  run         GithubWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  jobId       BigInt
  name        String
  status      String
  conclusion  String?
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([runId, jobId])
  @@index([runId])
}

model GithubRelease {
  id           String         @id @default(cuid())
  repoId       String
  repo         AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  releaseId    BigInt
  tagName      String
  name         String?
  draft        Boolean
  prerelease   Boolean
  targetCommit String?
  url          String
  publishedAt  DateTime
  createdAt    DateTime       @default(now())

  @@unique([repoId, releaseId])
  @@index([repoId])
  @@index([publishedAt])
}

model GithubPackage {
  id          String         @id @default(cuid())
  repoId      String
  repo        AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  packageType String
  name        String
  visibility  String
  url         String
  latestTag   String?
  updatedAt   DateTime

  @@unique([repoId, name])
  @@index([repoId])
}

model GithubPullRequest {
  id         String         @id @default(cuid())
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  number     Int
  url        String         @unique
  title      String
  state      String
  author     String
  branch     String
  baseBranch String
  createdAt  DateTime
  updatedAt  DateTime
  mergedAt   DateTime?
  isDraft    Boolean

  @@unique([repoId, number])
  @@index([repoId])
  @@index([state])
}

model GithubCommit {
  id         String         @id @default(cuid())
  repoId     String
  repo       AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  sha        String         @unique
  message    String
  author     String
  authorDate DateTime
  url        String

  @@index([repoId])
  @@index([authorDate])
}

model AutomationEvent {
  id          String         @id @default(cuid())
  repoId      String
  repo        AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  description String?
  actor       String?
  url         String?
  sha         String?
  branch      String?
  status      String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([repoId])
  @@index([eventType])
  @@index([createdAt])
}

model AutomationSyncRun {
  id               String         @id @default(cuid())
  repoId           String
  repo             AutomationRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  status           String
  reposFetched     Int            @default(0)
  workflowsFetched Int            @default(0)
  runsFetched      Int            @default(0)
  errorMessage     String?
  notes            String? @db.Text
  startedAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([repoId])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Issue sync run tracking (for scheduled sync endpoint)
// ---------------------------------------------------------------------------

model IssueSyncRun {
  id               String   @id @default(cuid())
  status           String
  reposFetched     Int      @default(0)
  syncedCount      Int      @default(0)
  errorMessage     String?
  notes            String?  @db.Text
  syncType         String   @default("scheduled") // "scheduled" | "manual" | "pre-claim"
  startedAt        DateTime @default(now())
  completedAt      DateTime?

  @@index([startedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Sync lock — single-row table to prevent overlapping scheduled sync runs.
// Uses a single row (id = "global") with atomic upsert for lock acquisition.
// ---------------------------------------------------------------------------

model SyncLock {
  id          String   @id
  syncRunId   String?
  acquiredAt  DateTime @default(now())

  @@map("sync_lock")
}

// ---------------------------------------------------------------------------
// Agent work lease / checkpoint — tracks active agent work on issues/PRs.
// ---------------------------------------------------------------------------

enum AgentWorkState {
  CLAIMED
  IN_PROGRESS
  BLOCKED
  DONE
  RELEASED
  STALE
}

enum AgentWorkCheckpoint {
  CLAIMED
  REPO_PREPARED
  BRANCH_CREATED
  CHANGES_MADE
  TESTS_RUNNING
  PR_OPENED
  DONE
  BLOCKED
}

model AgentWork {
  id              String            @id @default(cuid())
  agentName       String
  issueId         String?
  issue           Issue?            @relation(fields: [issueId], references: [id])
  runId           String?
  state           AgentWorkState    @default(CLAIMED)
  checkpoint      AgentWorkCheckpoint @default(CLAIMED)
  branch          String?
  prUrl           String?
  leaseExpiresAt  DateTime?
  lastHeartbeatAt DateTime          @default(now())
  summary         String?           @db.Text
  blockerReason   String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  history         AgentWorkHistory[]

  @@index([agentName])
  @@index([state])
  @@index([issueId])
}

model AgentWorkHistory {
  id            String             @id @default(cuid())
  workId        String
  work          AgentWork          @relation(fields: [workId], references: [id], onDelete: Cascade)
  at            DateTime           @default(now())
  action        String
  state         AgentWorkState?
  checkpoint    AgentWorkCheckpoint?
  summary       String?            @db.Text
  blockerReason String?            @db.Text

  @@index([workId])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Agent work leases — durable checkpointing for resumable agent work.
//
// A Lease represents an agent's active ownership of a specific issue. It is
// created or renewed on claim, checked on active-work queries, and expired
// after a configurable TTL so that stale work can be recovered by other agents.
// ---------------------------------------------------------------------------

model Lease {
  id         String   @id @default(cuid())
  agentName  String
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  checkpoint String   // e.g. "issue_claimed", "branch_created", etc.
  branch     String?  // working branch name
  prUrl      String?  // associated PR URL if one exists
  expiredAt  DateTime // absolute expiry; default TTL is set at creation time
  renewedAt  DateTime?
  createdAt  DateTime @default(now())

  @@unique([agentName, issueId])
  @@index([agentName, expiredAt])
  @@index([expiredAt])
  @@index([issueId])
}
