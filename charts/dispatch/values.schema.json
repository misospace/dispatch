{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dispatch Helm Chart Values",
  "type": "object",
  "required": ["image"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": { "type": "string" }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" }
        }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "authMode": {
          "type": "string",
          "enum": ["basic", "oidc", "disabled"],
          "description": "Authentication mode"
        },
        "excludedLabels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "llmBaseUrl": { "type": "string" },
        "groomer": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "model": { "type": "string" },
            "dryRun": { "type": "boolean" },
            "repoContext": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "scheduler": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "intervals": {
              "type": "object",
              "properties": {
                "syncMs": { "type": "integer", "minimum": 0 },
                "groomerMs": { "type": "integer", "minimum": 0 },
                "prFollowupMs": { "type": "integer", "minimum": 0 },
                "pruneClosedMs": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "claimable"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "claimable": { "type": "boolean" },
              "role": {
                "type": "string",
                "enum": ["default", "escalation"]
              },
              "description": { "type": "string" },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "defaultAgent": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "laneAliases": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "existingSecret": { "type": "string" },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "kind": { "type": "string" },
              "group": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
