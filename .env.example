# Primary connection string (canonical — used by Prisma at runtime)
DATABASE_URL="postgresql://dispatch:dispatch@localhost:5432/dispatch"

# GitHub integration
GITHUB_TOKEN="your_github_token_here"
GITHUB_REPOSITORIES="myorg/myrepo1,myorg/myrepo2"

# Agent API authentication (preferred)
DISPATCH_AGENT_TOKEN="your_agent_token_here"

# Dispatch instance URL (preferred)
# DISPATCH_URL="http://localhost:3000"

# Alternative database URL aliases (v0.2.1 compatibility)
# DISPATCH_DATABASE_URL="postgresql://..." — preferred alias, falls back to DATABASE_URL if set
# MISSION_CONTROL_DATABASE_URL="postgresql://..." — deprecated, will be removed in v0.2.2

# Legacy environment variables (v0.2.1 compatibility only)
# MISSION_CONTROL_AGENT_TOKEN — deprecated alias for DISPATCH_AGENT_TOKEN
# MISSION_CONTROL_URL — deprecated alias for DISPATCH_URL
# These are accepted through v0.2.1 and will be removed in v0.2.2.

# NextAuth.js (stub for local development)
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"