# Primary connection string (canonical — used by Prisma at runtime)
DATABASE_URL="postgresql://dispatch:dispatch@localhost:5432/dispatch"

# GitHub integration
GITHUB_TOKEN="your_github_token_here"
GITHUB_REPOSITORIES="myorg/myrepo1,myorg/myrepo2"

# GitHub App authentication (optional — provides separate timeline identity)
#
# When all three vars below are set, Dispatch authenticates as a GitHub App
# installation instead of using the shared GITHUB_TOKEN PAT. This gives clear
# attribution in GitHub issue timelines.
#
# If any of these are missing, Dispatch falls back to GITHUB_TOKEN.
# Partial configuration is silently ignored (falls back to PAT).
#
# Private key supports both real PEM newlines and escaped \n form
# (Kubernetes / ExternalSecrets-style env injection).
#
# GITHUB_APP_ID="123456"
# GITHUB_APP_INSTALLATION_ID="1234567890abcdef"
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Agent API authentication
#
# Bearer tokens come in two tiers. The maintainer tier keeps full rights
# (force claims, releasing other agents' claims, PR-fix queue requeue and
# QUEUED/IGNORED marks, groomer, lanes, admission overrides, automation,
# syncs); the worker tier is an explicit allowlist for autonomous executors
# (next-task, tasks/report, heartbeat, active-work, queue, work-summary,
# agent-work start/checkpoint/finish, non-force claim and unclaim,
# issue state/status, PR-fix queue reads and FIXED/BLOCKED/STALE marks).
# A worker token calling a maintainer route gets a 403 naming the required
# tier. See "Token Tiers" in docs/worker-execution-contract.md.
#
# DISPATCH_AGENT_TOKEN is the maintainer-tier token.
DISPATCH_AGENT_TOKEN="your_agent_token_here"
# Optional alias for the maintainer-tier token (same rights as
# DISPATCH_AGENT_TOKEN).
# DISPATCH_MAINTAINER_TOKEN="your_maintainer_token_here"
# Worker-tier bearer token for autonomous executors (e.g. worker harnesses).
# Unset by default; must be distinct from the maintainer tokens — a duplicate
# is treated as worker-tier only (fail-closed) and logs a warning at boot.
# DISPATCH_WORKER_TOKEN="your_worker_token_here"

# Operator / UI authentication (optional)
#
# Auth modes: "basic", "oidc", or "disabled"
#
# "basic"    — HTTP Basic Auth (browser prompts for username/password)
# "oidc"     — OIDC provider authentication (SSO login page)
# "disabled" — No auth enforcement (local development only)
#
# When DISPATCH_AUTH_MODE is not set, legacy mode is used:
# Bearer token auth via DISPATCH_AGENT_TOKEN for API calls.

# --- Basic Auth mode ---
# DISPATCH_AUTH_MODE="basic"
# DISPATCH_AUTH_USERNAME="admin"
# DISPATCH_AUTH_PASSWORD="change-me-in-production"

# --- OIDC mode ---
# Set DISPATCH_AUTH_MODE="oidc" and configure your OIDC provider:
# DISPATCH_AUTH_MODE="oidc"
# DISPATCH_OIDC_ISSUER="https://your-issuer.example.com"
# DISPATCH_OIDC_CLIENT_ID="your-oidc-client-id"
# DISPATCH_OIDC_CLIENT_SECRET="your-oidc-client-secret"
# NEXTAUTH_SECRET="a-long-random-string-for-session-signing"
# NEXTAUTH_URL="http://your-dispatch-url.example.com"

# Set to "disabled" to allow full open access (no auth enforcement).
# Useful for local development only.
# DISPATCH_AUTH_MODE="disabled"

# Default agent identity for MCP clients (optional but recommended)
# Set this to a stable operator identity such as "jory-opencode".
# Prevents models from inventing poor identities like "Dispatch MCP" when claiming work.
# DISPATCH_AGENT_NAME="jory-opencode"

# Dispatch instance URL (used by outbound clients and MCP bridge)
# DISPATCH_URL="http://localhost:3000"

# Alternative database URL alias — used if DATABASE_URL is not set
# DISPATCH_DATABASE_URL="postgresql://..."

# Closed issue cache retention (days) — closed issues older than this are pruned via POST /api/issues/prune-closed
# DISPATCH_CLOSED_ISSUE_RETENTION_DAYS=30

# Done issue visibility retention (days) — recently closed Done issues appear in Board/Projects/API for this window; old Done issues are hidden by default (default: 7)
# DISPATCH_DONE_RETENTION_DAYS=7

# NextAuth.js secret — required for OIDC mode (JWT signing).
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEXTAUTH_SECRET="your_nextauth_secret_here"
# NEXTAUTH_URL="http://localhost:3000"

# Public base URL used to construct the OIDC callback (`/api/auth/callback/...`).
# Optional; falls back to NEXTAUTH_URL. Set this if Dispatch sits behind a
# reverse proxy that rewrites the public origin.
# AUTH_URL="https://dispatch.example.com"

# --- Issue triage & queue ---

# Comma-separated label names that should be excluded from triage, grooming,
# and queue calculations. Useful for ignoring labels like `wontfix` or
# `duplicate` so they never surface in the operator UI.
# DISPATCH_EXCLUDED_LABELS="wontfix,duplicate,spam"

# JSON-encoded lane configuration. Schema:
#   { "<lane-name>": { "labels": ["priority/high", ...], "tier": 0|1|2 } }
# Tiers render in the queue UI as prioritized columns. When unset, lanes are
# auto-derived from labels prefixed with `lane/`.
# DISPATCH_LANE_CONFIG_JSON='{"default":{"labels":[],"tier":0},"hot":{"labels":["priority/high"],"tier":1}}'

# Comma-separated numbers (days) defining aging buckets per queue tier. The
# first entry applies to the highest-priority tier, then 2nd, etc. Issues older
# than the matching bucket are highlighted in the queue UI.
# DISPATCH_QUEUE_AGING_DAYS_PER_TIER="2,5,10,20"

# Maximum number of aging buckets the queue UI will render, regardless of how
# many entries are in DISPATCH_QUEUE_AGING_DAYS_PER_TIER.
# DISPATCH_QUEUE_AGING_MAX_TIERS=4

# Grooming freshness admission for the worker queue (#1065): off (default,
# unchanged behaviour), audit (expose the decision on queue items, filter
# nothing) or enforce (hand ready issues to implementation workers only with a
# current applied grooming decision or an operator override). Unrecognised
# values mean off. See docs/hosted-groomer.md#worker-admission.
# DISPATCH_QUEUE_ADMISSION_MODE="off"

# Maximum age (ms) before a stale sync lock is considered abandoned and may be
# reclaimed by a new sync run. Default 1 800 000 (30 minutes).
# DISPATCH_SYNC_LOCK_MAX_AGE_MS=1800000

# --- LLM Groomer ---

# Comma-separated agent identifiers exposed by GET /api/issues/actions/agents.
# When unset, Dispatch returns the built-in default set
# (e.g. `foreman-coder, foreman-reviewer`).
# AGENTS="foreman-coder,foreman-reviewer"

# --- Groomer (background issue tidy-up) ---

# Set to "true" to enable the background groomer. Required even for the
# in-process LLM groomer.
# DISPATCH_HOSTED_GROOMER_ENABLED="true"

# Dry-run mode. When "true" the groomer returns a mutation plan without GitHub
# or DB writes; a request body `{ "dryRun": false }` overrides it per run.
# Defaults to "true" (set "false" to let the groomer write).
# DISPATCH_GROOMER_DRY_RUN="true"
# Send response_format (json_schema, then json_object) to the LLM. Set false for
# backends that implement neither; applies to the groomer and the lesson feed.
# DISPATCH_LLM_RESPONSE_FORMAT="true"

# Minimum hours between automated groomer comments on the same issue, to
# avoid spamming the issue timeline.
# DISPATCH_GROOMER_COMMENT_COOLDOWN_HOURS=24

# LLM request timeout (ms) for the grooming call. When unset it scales with
# DISPATCH_GROOMER_MAX_CONTEXT_BYTES: 60s + 5s per KB, clamped to 60s-300s
# (100 000 at the default 8192 bytes).
# DISPATCH_GROOMER_TIMEOUT_MS=100000

# Optional separate bearer token accepted by POST /api/groomer/run in addition
# to the standard auth (DISPATCH_AGENT_TOKEN, basic, OIDC), for an external
# groomer scheduler. Requests using it act as "hosted-groomer-scheduler". Unset
# by default; use a different value from DISPATCH_AGENT_TOKEN.
# DISPATCH_GROOMER_TOKEN="your_groomer_token_here"

# Held external-participant replies: "pending" queues for operator review;
# "off" suppresses without queueing. Defaults to "pending".
# DISPATCH_GROOMER_EXTERNAL_REPLIES=pending

# GitHub logins trusted by the external-participant reply gate. Empty by default.
# DISPATCH_GROOMER_TRUSTED_LOGINS=

# Model used by the LLM groomer. No default: required when
# DISPATCH_HOSTED_GROOMER_ENABLED is "true" (groomer config throws without it).
# DISPATCH_GROOMER_MODEL="gpt-4o-mini"

# Issue context budget (bytes) sent to the model per grooming call. Default 8192.
# DISPATCH_GROOMER_MAX_CONTEXT_BYTES=8192

# Maximum number of repo files included in repository context. Default 5.
# DISPATCH_GROOMER_MAX_CONTEXT_FILES=5

# Maximum bytes per fetched repo file snippet. Default 4096.
# DISPATCH_GROOMER_MAX_FILE_BYTES=4096

# Maximum GitHub code searches per grooming run. Default 3.
# DISPATCH_GROOMER_MAX_SEARCHES=3

# When "true", the groomer gathers bounded repository context (metadata,
# code-search snippets, file text) through GitHub REST APIs before drafting a
# comment. Defaults to "false".
# DISPATCH_GROOMER_REPO_CONTEXT_ENABLED="false"

# When "true", the groomer explores the repository itself through a tool loop
# (search_code, read_file, list_directory, submit_findings) instead of one
# pre-computed context block. Defaults to "true".
# DISPATCH_GROOMER_TOOL_LOOP_ENABLED="true"

# Maximum model round-trips the exploration loop may make. One round can carry
# several tool calls. DISPATCH_GROOMER_MAX_TOOL_CALLS is a deprecated alias,
# read only when DISPATCH_GROOMER_MAX_ROUNDS is unset.
# DISPATCH_GROOMER_MAX_ROUNDS=12
# DISPATCH_GROOMER_MAX_TOOL_CALLS=12

# Maximum code-search results returned to the model per search_code call.
# DISPATCH_GROOMER_MAX_SEARCH_RESULTS=10

# Maximum directory entries returned to the model per list_directory call.
# DISPATCH_GROOMER_MAX_DIR_ENTRIES=60

# Exploration budget preset: "small" (8 KB / 4 KB per file / 90s), "medium"
# (24 KB / 8 KB / 150s) or "large" (96 KB / 24 KB / 300s). Defaults to "medium".
# DISPATCH_GROOMER_CONTEXT_MODE="medium"

# The model's real context window (tokens). When set, the exploration budget is
# derived from it (capped at the "large" preset) and CONTEXT_MODE is ignored.
# Unset by default; the value below is only an example.
# DISPATCH_GROOMER_MODEL_CONTEXT_TOKENS=32768

# Individual exploration budget overrides; each wins over the preset or the
# derived value. Bytes of tool output across all rounds, bytes per file (never
# more than the total), and the loop's wall-clock cap (ms). Unset by default;
# the values below are the "medium" preset.
# DISPATCH_GROOMER_EXPLORE_MAX_BYTES=24576
# DISPATCH_GROOMER_EXPLORE_MAX_FILE_BYTES=8192
# DISPATCH_GROOMER_EXPLORE_TIMEOUT_MS=150000

# Days a not-ready deferral keeps an issue out of grooming before the groomer
# revisits it. Default 14.
# DISPATCH_DEFERRAL_TTL_DAYS=14

# --- LLM configuration (groomer + lesson feed) ---

# Both the hosted groomer and the lesson feed (src/lib/lesson-feed.ts) read the
# same DISPATCH_LLM_* vars, so a deployment that only sets these works for both.
# Set these first; the OPENAI_* vars below are a legacy fallback only.

# OpenAI-compatible API key. Read by the groomer and the lesson feed.
# DISPATCH_LLM_API_KEY="sk-..."
# Legacy fallback. Used only when DISPATCH_LLM_API_KEY is unset (a one-time
# lesson-feed warning fires when an OPENAI_* fallback is used).
# OPENAI_API_KEY="sk-..."

# OpenAI-compatible base URL. Read by the groomer and the lesson feed.
# DISPATCH_LLM_BASE_URL="https://api.openai.com/v1"
# Legacy fallback. Used only when DISPATCH_LLM_BASE_URL is unset.
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Model for the lesson feed. Precedence: DISPATCH_LESSON_FEED_MODEL >
# DISPATCH_GROOMER_MODEL > OPENAI_MODEL (legacy) > gpt-4o-mini.
# DISPATCH_LESSON_FEED_MODEL="gpt-4o-mini"
# DISPATCH_GROOMER_MODEL="gpt-4o-mini"
# Legacy fallback. Used only when neither DISPATCH_LESSON_FEED_MODEL nor
# DISPATCH_GROOMER_MODEL is set.
# OPENAI_MODEL="gpt-4o-mini"

# Opt-in gate for the lesson feed (#970). When unset, or anything other than
# the literal string "true", extractLessonFromFixOutcome() in
# src/lib/lesson-feed.ts returns no_lesson without making any LLM call.
# The pr-fix queue no longer fires the feed automatically — deployments
# that want their own downstream (dedupe via lessonAlreadyCovered + open
# an AGENTS.md PR) must enable this env var and wire the call themselves.
# DISPATCH_LESSON_FEED_ENABLED="false"

# --- PR Followup (inbound webhooks) ---

# HMAC-SHA256 shared secret used to verify inbound webhook payloads. See
# docs/pr-review-fix-queue.md for the event contract. Must be a long random
# string (>= 32 bytes recommended).
# WEBHOOK_SECRET="replace-with-a-long-random-string"

# Set to "true" to disable the built-in signature check because an upstream
# API gateway has already verified the request. Must be the literal string
# "true" or "false", not a boolean.
# WEBHOOK_GATEWAY_MODE="false"

# JSON object mapping bot logins (e.g. "dependabot[bot]") to a behaviour
# label. When a webhook event arrives from a listed identity, Dispatch skips
# its followup handling.
# PR_FOLLOWUP_BOT_IDENTITIES='{"dependabot[bot]":"auto-merge","renovate[bot]":"auto-merge"}'

# Comma-separated GitHub logins that should be considered the canonical owner
# of a followup branch. Used to suppress "needs author" nudges.
# PR_FOLLOWUP_BRANCH_OWNERS="octocat,mona"

# Automatic fix attempts a PR-fix queue item may be dispatched for before it is
# moved to BLOCKED in the NEEDS_HUMAN lane instead of being re-queued. An
# attempt is a return to QUEUED (new evidence after a fix, or a refused
# no-push FIXED); extra comments on already-queued work do not count. An
# operator requeue resets the count. Default 5.
# PR_FIX_MAX_ATTEMPTS=5

# How long (ms) a stamped PR-fix hand-out may sit unacknowledged before the
# reclaimer treats it as abandoned and reopens the item as a fresh generation
# (#1211). A worker that durably materialized its attempt acknowledges it; a
# stamped hand-out with no acknowledgement past this window means the executor
# likely died before creating its run. Default 1 800 000 (30 min).
# PR_FIX_HANDOUT_TIMEOUT_MS=1800000

# Bound on automatic reclamations of a stale unacknowledged hand-out before the
# item is routed to BLOCKED in the NEEDS_HUMAN lane instead of being reclaimed
# again (#1211). An operator requeue resets the count. Default 3.
# PR_FIX_MAX_RECLAIMS=3

# --- Legacy aliases (do not set) ---

# MISSION_CONTROL_URL and MISSION_CONTROL_AGENT_TOKEN were renamed to
# DISPATCH_URL and DISPATCH_AGENT_TOKEN. They are referenced only by legacy
# test fixtures and are ignored at runtime. Listed here for discoverability.
# MISSION_CONTROL_URL="https://dispatch.example.com"
# MISSION_CONTROL_AGENT_TOKEN="legacy-token"

# --- Scheduler (background job intervals) ---

# Set to "true" to enable the in-process scheduler. When unset or "false", the
# scheduler is disabled and jobs must be triggered externally (e.g. by a cron
# or k8s CronJob hitting the `/api/*/scheduled` endpoints).
# DISPATCH_SCHEDULER_ENABLED="false"

# How long the scheduler waits (ms) after server start before firing its first
# job, so cold-start work isn't competing with the first sync. Default 5000.
# DISPATCH_SCHEDULER_STARTUP_DELAY_MS=5000

# Interval (ms) between automated `/api/sync/scheduled` runs. Set to "0" to
# disable this job while keeping the scheduler enabled. Default 900 000 (15 min).
# DISPATCH_SYNC_INTERVAL_MS=900000

# Interval (ms) between automated `/api/groomer/run` runs. Set to "0" to
# disable. Default 600 000 (10 min).
# DISPATCH_GROOMER_INTERVAL_MS=600000

# Interval (ms) between automated `/api/pr-followup/sync` runs. Set to "0" to
# disable. Default 900 000 (15 min).
# DISPATCH_PR_FOLLOWUP_INTERVAL_MS=900000

# Interval (ms) between automated `/api/issues/prune-closed` runs. Set to "0"
# to disable. Default 86 400 000 (24 h).
# DISPATCH_PRUNE_CLOSED_INTERVAL_MS=86400000

# Interval (ms) between automated `/api/issues/reconcile` runs. Set to "0" to
# disable. Default 1 800 000 (30 min).
# DISPATCH_RECONCILE_INTERVAL_MS=1800000

# Interval (ms) between automated `/api/agent-work/sweep` runs that reclaim
# agent-work leases abandoned by an agent that died mid-task. Set to "0" to
# disable. Default 300 000 (5 min).
# DISPATCH_STALE_WORK_INTERVAL_MS=300000

# Interval (ms) between automated `/api/pr-fix-queue/sweep` runs that reclaim
# stale unacknowledged PR-fix hand-outs (a worker died before durably creating
# its run). Set to "0" to disable. Default 300 000 (5 min).
# DISPATCH_PR_FIX_SWEEP_INTERVAL_MS=300000

# Interval (ms) between automated `/api/ci-failures/sync` runs, which file an
# issue when a workflow fails twice in a row on a repo's default branch and
# close it after two consecutive green runs. Set to "0" to disable. Default
# 1 800 000 (30 min).
# DISPATCH_CI_FAILURES_INTERVAL_MS=1800000

# Comma-separated labels applied to issues filed by the CI-failure sync. Set to
# an empty string to apply none. Default "type/bug,status/ready".
# DISPATCH_CI_FAILURE_LABELS="type/bug,status/ready"

# --- Framework / build-time vars (set by the platform, do not override) ---

# NODE_ENV, NEXT_RUNTIME, and NEXT_PUBLIC_DISPATCH_VERSION are managed by the
# Next.js runtime or build process. PORT is set to 3000 by the Dockerfile; the
# scheduler also reads it for its loopback calls (default 3000). They are
# intentionally omitted from this example to avoid confusion.
